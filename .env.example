# Standalone / docker run config (ignored when installed as HA addon).
# Copy to .env and fill values:  cp .env.example .env

# RTSP stream. OpenCV also accepts a local video file path for testing.
# Leave EMPTY for mock mode: no camera, just upload images at http://<host>:8099
RTSP_URL=rtsp://192.168.1.199:8554/bramaRtsp

MQTT_HOST=192.168.1.199
MQTT_PORT=1883
MQTT_USERNAME=pawel
MQTT_PASSWORD=changeme
MQTT_TOPIC=plate_recognizer/plate
MQTT_ENABLE_TOPIC=plate_recognizer_enable

# Home Assistant MQTT discovery: auto-create the plate sensor. true/false.
MQTT_DISCOVERY=true
DEVICE_NAME=ha-plate-recognizer

# Vehicle gate (MediaPipe object detector).
MIN_CAR_SCORE=0.4
DETECT_CLASSES=car

# Plate OCR (fast-alpr).
MIN_PLATE_CONFIDENCE=0.5
# Don't re-publish the same plate within this many seconds.
COOLDOWN=30

# Seconds between analysed frames (lower = faster reaction, more CPU).
ANALYZE_INTERVAL=0.4

# CLAHE contrast boost for backlit / uneven lighting. true/false.
ENHANCE_CONTRAST=false

# Web debug preview (MJPEG). Open http://<host>:WEB_PORT
WEB_UI=true
WEB_PORT=8099

# Region-of-interest crop (fractions of frame, 0..1). Default = full frame.
# Example: cars only appear in the bottom half -> ROI_TOP=0.5
ROI_TOP=0.5
ROI_BOTTOM=1.0
ROI_LEFT=0.0
ROI_RIGHT=1.0
